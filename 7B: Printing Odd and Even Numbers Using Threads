class Odd extends Thread
{
    public void run()
    {
        for (int i = 1; i <= 20; i++)
        {
            System.out.print("Odd = " + i);
        }
    }
}

class Even extends Thread
{
    public void run()
    {
        for (int i = 2; i <= 20; i += 2)
        {
            System.out.println("Even: " + i);
        }
    }
}

public class Main
{
    public static void main(String args[])
    {
        Odd t1 = new Odd();
        Even t2 = new Even();
        t1.start();
        t2.start();
    }
}
